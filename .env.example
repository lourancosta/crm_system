PORT=80
# Public URL this app is reachable at - used to build absolute links in
# outgoing emails (e.g. the {{invoicePreviewUrl}} merge token in invoice
# reminders). No trailing slash.
APP_BASE_URL=http://localhost:5173

DB_CONNECTION=mysql
DB_HOST=mysql-writer.internal.example.com
DB_HOST_READ=mysql-reader.internal.example.com
DB_PORT=3306
DB_DATABASE=crm_system_dev
DB_USERNAME=dev_crm
DB_PASSWORD=secret_password_here

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_this_to_a_random_hex_string_of_at_least_32_characters

# Outgoing email accounts (SMTP) are configured per-feature in
# Settings > Email Accounts, not via env vars - each feature (invoice
# reminders, quotes, user communications, ...) can send from a different
# real mailbox. Passwords are encrypted at rest with this key:
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMAIL_ENCRYPTION_KEY=change_this_to_a_random_base64_32_byte_key

# Support inbox mailboxes (IMAP) are configured in Settings > Tickets >
# Support Inbox, not via env vars - each connected mailbox has its own
# encrypted password (reuses EMAIL_ENCRYPTION_KEY above). Cron schedules for
# invoice reminders (daily 8am) and inbound email polling (every 5 min) are
# hardcoded in src/cron/ - not configurable via env var.

# When set, ALL outgoing emails are redirected to this address instead of real
# recipients (subject line notes who the real recipients would have been).
# Leave unset in production. Strongly recommended in dev/staging since this DB
# contains real HubSpot-synced customer contacts.
TEST_EMAIL_OVERRIDE=you@yourdomain.com